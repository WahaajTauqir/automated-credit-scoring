### backend/.env.example
# Copy this file to backend/.env and fill values. Do NOT commit real secrets.

# Option A: single connection string (preferred)
# DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>

# Option B: split components (some apps may read these separately)
# NOTE: db.py expects PG_DBNAME (not PG_DB) so set PG_DBNAME if you use the split form
PG_USER=myuser
PG_PASSWORD=mypassword
PG_DBNAME=mydb
PG_HOST=127.0.0.1
PG_PORT=5432

# GitHub Models token (required for AI classification). Do NOT commit a real token.
# Create a personal access token with the 'models:read' permission and set it here.
GITHUB_TOKEN=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

# Optional runtime settings
PORT=5000
DEBUG=true
