%% Module 11: Performance Validation
%% Goal: Quantify discrimination, calibration, stability.
%%{init: {"theme": "dark", "flowchart": {"defaultRenderer": "elk", "htmlLabels": false}} }%%
flowchart TB
    classDef step fill:#3b2f13,stroke:#fbbf24,color:#ffffff;
    classDef decision fill:#5a431a,stroke:#f59e0b,color:#ffffff;

    A((From Score Scaling)):::step
    S0["Compute Discrimination: AUC, KS, Gini (2*AUC-1)"]:::step
    S1["Calibration: Hosmer-Lemeshow p>0.05; Brier Score"]:::step
    S2["Lift & Gains Chart, Population Stability (PSI <0.1) train vs val"]:::step
    S3["Reject Inference (if necessary): augmentation documentation"]:::step
    D1{"KS < 0.25 or AUC < 0.65?"}:::decision
    S4["Investigate feature set / binning / model spec"]:::step
    S5["Produce Validation Report PDF/HTML"]:::step
    E((To Fairness & Bias))

    A --> S0 --> S1 --> S2 --> S3 --> D1
    D1 -->|Yes| S4 --> S0
    D1 -->|No| S5 --> E

    subgraph OUTPUTS [Artifacts]
        O1[Validation Metrics Table]
        O2[Charts]
        O3[Report]
    end
    style OUTPUTS fill:#111827,stroke:#6b7280,stroke-dasharray: 3 3,color:#ffffff

    click E "./module_12_fairness_bias.mmd" "Next: Fairness & Bias" _self
