%% Module 12: Fairness & Bias Assessment
%% Goal: Assess disparate impact across protected attributes (if legally permissible to evaluate).
%%{init: {"theme": "dark", "flowchart": {"defaultRenderer": "elk", "htmlLabels": false}} }%%
flowchart TB
    classDef step fill:#3b2f13,stroke:#fbbf24,color:#ffffff;
    classDef decision fill:#5a431a,stroke:#f59e0b,color:#ffffff;

    A((From Performance Validation)):::step
    S0["Identify Protected Attributes (e.g., gender, age band) - if available"]:::step
    S1["Compute Group Metrics: PD rate, Approval Rate, Average Score"]:::step
    S2["Adverse Impact Ratio (AIR) = min(approval_rate_group)/max(approval_rate_group)"]:::step
    D1{"AIR < 0.8?"}:::decision
    S3["Compute Difference in Mean Scores & KS between groups"]:::step
    S4["Run SHAP / Permutation importance per group"]:::step
    S5["Mitigation Options (if allowed): threshold adjustments, feature review"]:::step
    S6["Document Fairness Findings"]:::step
    E((To Monitoring & Drift))

    A --> S0 --> S1 --> S2 --> D1
    D1 -->|Yes| S5 --> S6 --> E
    D1 -->|No| S3 --> S4 --> S6 --> E

    subgraph OUTPUTS [Artifacts]
        O1[Fairness Metrics]
        O2[Mitigation Notes]
    end
    style OUTPUTS fill:#111827,stroke:#6b7280,stroke-dasharray: 3 3,color:#ffffff

    click E "./module_13_monitoring.mmd" "Next: Monitoring" _self
