%% Module 09: Interpretable Model Training
%% Primary: Logistic Regression (penalized) producing scorecard. Alternative: Gradient Boosting for benchmark.
%%{init: {"theme": "dark", "flowchart": {"defaultRenderer": "elk", "htmlLabels": false}} }%%
flowchart TB
    classDef step fill:#3b1324,stroke:#f472b6,color:#ffffff;
    classDef decision fill:#3b2f13,stroke:#fbbf24,color:#ffffff;

    A((From Encoding)):::step
    S0["Baseline logistic (WoE features); penalty L1 or ElasticNet (CV); class-weight balanced if minority<20%"]:::step
    S1["Iterative Backward Selection: remove p-value>0.05 if IV small & not mandated"]:::step
    S2["Check Signs vs WoE (Expect positive coef for higher risk WoE)"]:::step
    D1{"Sign Inconsistent?"}:::decision
    S3["Investigate / merge bins / drop variable"]:::step
    S4["Regularization Path & AIC/BIC comparison"]:::step
    S5["Alternative model (XGBoost/LightGBM) — early stopping; max_depth <=4 for interpretability"]:::step
    S6["Compare Metrics (AUC, KS, Gini, Brier)"]:::step
    E((To Score Scaling))

    A --> S0 --> S1 --> S2 --> D1
    D1 -->|Yes| S3 --> S2
    D1 -->|No| S4 --> S5 --> S6 --> E

    subgraph OUTPUTS [Artifacts]
        O1[Logistic Coefficients]
        O2[Scorecard Draft]
        O3[Benchmark Model Metrics]
    end
    style OUTPUTS fill:#111827,stroke:#6b7280,stroke-dasharray: 3 3,color:#ffffff

    click E "./module_10_score_scaling.mmd" "Next: Score Scaling" _self
