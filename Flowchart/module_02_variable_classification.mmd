%% Module 02: Variable Classification
%% Aim: Deterministic tagging of variables to drive downstream logic.
%%{init: {"theme": "dark", "flowchart": {"defaultRenderer": "elk", "htmlLabels": false}} }%%
flowchart TB
    classDef step fill:#1e293b,stroke:#60a5fa,stroke-width:1px,color:#ffffff;
    classDef decision fill:#3b2f13,stroke:#fbbf24,stroke-width:1px,color:#ffffff;
    classDef tag fill:#1f3d18,stroke:#65a30d,stroke-width:1px,color:#ffffff;

    A((From Ingestion)):::step
    S1["Identify target column — must be binary 0/1 or Y/N; positive='Bad' by default; validate minority class >=3% (if lower, options: collect more labels OR proceed with mitigation)"]:::step
    D1{"Minority < 3%?"}:::decision
    C1["Proceed with caution — use class weights or controlled downsampling; enforce min_bad_per_bin=30–50; prefer targeted enrichment of positives"]:::step
    S2["Scan numerical columns — numeric type; distinct ratio>0.05 -> continuous; else candidate discrete"]:::step
    S3["Scan categorical/text — lowercase & trim; cardinality>50 -> high-card (consider hashing); 2-50 -> categorical; 1 -> constant(drop)"]:::step
    S4["Date & derived temporal — extract age_in_months, day_of_week, month"]:::step
    S5["Flag special types — ID-like (regex/length); high-missing (>40%); leakage candidates (contains 'target','default','risk')"]:::step
    S6["Generate data dictionary — write Postgres table 'data_dictionary' (cols: variable_name, type_tag, cardinality, missing_pct, sample_values, notes); also export JSON artifact for downstream tools"]:::tag
    E((To Missing Data Handling)):::step

    F1["Review / Re-specify Target or Collect More Data"]

    A --> S1 --> D1
    D1 -->|Yes — prefer collect more labels| F1
    D1 -->|Yes — operationally allowed to proceed| C1
    D1 -->|No| S2 --> S3 --> S4 --> S5 --> S6 --> E
    C1 --> S2

    subgraph TAGS [Resulting Tags]
        T1[continuous]
        T2[categorical]
        T3[high_cardinality]
        T4[id_like]
        T5[constant_drop]
        T6[high_missing]
        T7[leakage_flag]
    end
    style TAGS fill:#111827,stroke:#6b7280,stroke-dasharray: 3 3,color:#ffffff

    click E "./module_03_missing_values.mmd" "Next: Missing Values" _self
