%% Module 04: Outlier Detection & Treatment
%% Goal: Stabilize extremes while preserving rank ordering relevant to risk.
%% Techniques: Winsorization (quantile), IQR fences, Z-score (robust), Capping by business rules.
%%{init: {"theme": "dark", "flowchart": {"defaultRenderer": "elk", "htmlLabels": false}} }%%
flowchart TB
    classDef step fill:#1e293b,stroke:#60a5fa,color:#ffffff;
    classDef decision fill:#3b2f13,stroke:#fbbf24,color:#ffffff;

    A((From Missing Handling)):::step
    S0["For continuous vars compute: Q1,Q3,IQR, P0.5,P99.5, Median Absolute Deviation"]:::step
    S1["Flag outliers if any condition: value < Q1-1.5*IQR; value > Q3+1.5*IQR; |robust Z|>4 ((x-median)/1.4826*MAD)"]:::step
    D1{"Outlier Rate > 10%?"}:::decision
    S2["If <=10% -> Winsorize at (P1, P99) or (P0.5,P99.5) chosen to keep skew<2"]:::step
    S3["If >10% -> Consider Log/Box-Cox (lambda grid) OR leave if predictive monotonic"]:::step
    S4["Recompute summary stats post treatment"]:::step
    S5["Document caps & transformations"]:::step
    E((To Coarse Binning))

    A --> S0 --> S1 --> D1
    D1 -->|No| S2 --> S4 --> S5 --> E
    D1 -->|Yes| S3 --> S4 --> S5 --> E

    subgraph OPTIONS [Transform Options]
        O1[Winsorize]
        O2[Log1p]
        O3[Box-Cox]
        O4[No Change]
    end
    style OPTIONS fill:#111827,stroke:#6b7280,stroke-dasharray: 3 3,color:#ffffff

    click E "./module_05_coarse_binning.mmd" "Next: Coarse Binning" _self
