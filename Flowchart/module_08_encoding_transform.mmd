%% Module 08: Encoding & Transformations
%% Goal: Consolidate feature representations for modeling (logistic baseline + alternative).
%% Techniques: WoE for scorecard, One-Hot (low-card), Target Mean (with smoothing), Standardization.
%%{init: {"theme": "dark", "flowchart": {"defaultRenderer": "elk", "htmlLabels": false}} }%%
flowchart TB
    classDef step fill:#1e293b,stroke:#60a5fa,color:#ffffff;
    classDef decision fill:#3b2f13,stroke:#fbbf24,color:#ffffff;

    A((From Selection)):::step
    S0["For logistic scorecard: use WoE values"]:::step
    S1["For alt model (GBM/XGBoost): one-hot encode categorical (<=10 levels); target-mean encode medium-card (11-50) with K-fold smoothing; hash encode high-card (>50) (n_buckets=50-100)"]:::step
    S2["Standardize Continuous (z-score) if model requires"]:::step
    S3["Assemble Feature Matrix: X_base (WoE) + X_alt (non-WoE)"]:::step
    S4["Train/Validation Split (Stratified) 70/30 or Time-based"]:::step
    E((To Model Training))

    A --> S0 --> S1 --> S2 --> S3 --> S4 --> E

    subgraph OUTPUTS [Artifacts]
        O1[Feature Matrix WoE]
        O2[Alt Encoded Matrix]
        O3[Encoding Metadata]
    end
    style OUTPUTS fill:#111827,stroke:#6b7280,stroke-dasharray: 3 3,color:#ffffff

    click E "./module_09_model_training.mmd" "Next: Model Training" _self
