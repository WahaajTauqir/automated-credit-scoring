%% High-Level Automated Credit Scoring Pipeline Overview
%% Each major process node links to a detailed module .mmd file in this folder.
%% Order reflects a transparent, regulation-aligned scorecard development lifecycle.
%% Renderer elk improves layout for larger graphs.
%% Dark theme & higher contrast (addresses visibility)
%%{init: {"theme": "dark", "flowchart": {"defaultRenderer": "elk", "htmlLabels": true}, "themeVariables": {"primaryColor": "#1e293b", "primaryTextColor": "#ffffff", "primaryBorderColor": "#60a5fa"}} }%%
flowchart TB
	classDef proc fill:#1e293b,stroke:#60a5fa,stroke-width:1px,color:#ffffff;
	classDef decision fill:#3b2f13,stroke:#fbbf24,stroke-width:1px,color:#ffffff;
	classDef data fill:#1f3d18,stroke:#65a30d,stroke-width:1px,color:#ffffff;
	classDef risk fill:#3b1324,stroke:#f472b6,stroke-width:1px,color:#ffffff;
	classDef monitor fill:#374151,stroke:#9ca3af,stroke-width:1px,color:#ffffff;

	A((Start))
	B["<div style='color:#fff;font-weight:600'>1. Data Ingestion & Schema Validation<br/>(Format, types, constraints)</div>"]:::data
	C["<div style='color:#fff;font-weight:600'>2. Variable Classification<br/>(Target / Numeric / Categorical / High-Card / Text)</div>"]:::proc
	D["<div style='color:#fff;font-weight:600'>3. Missing Data Handling</div>"]:::proc
	E["<div style='color:#fff;font-weight:600'>4. Outlier Detection & Treatment</div>"]:::proc
	F["<div style='color:#fff;font-weight:600'>5. Coarse Binning (Quantile / ChiMerge)</div>"]:::proc
	G["<div style='color:#fff;font-weight:600'>6. Fine Binning (Monotonic Bad Rate)</div>"]:::proc
	H["<div style='color:#fff;font-weight:600'>7. WoE & IV Computation + Selection</div>"]:::proc
	I["<div style='color:#fff;font-weight:600'>8. Encoding & Transformations</div>"]:::proc
	J["<div style='color:#fff;font-weight:600'>9. Interpretable Model Training<br/>(LogReg Scorecard / Alt: GB + SHAP)</div>"]:::risk
	K["<div style='color:#fff;font-weight:600'>10. Score Scaling & Points-to-Odds</div>"]:::risk
	L["<div style='color:#fff;font-weight:600'>11. Performance Validation<br/>(AUC, KS, Gini, Brier, Calibration)</div>"]:::decision
	M["<div style='color:#fff;font-weight:600'>12. Fairness & Bias Assessment<br/>(PD Parity / Adverse Impact Ratio)</div>"]:::decision
	N["<div style='color:#fff;font-weight:600'>13. Monitoring & Drift (PSI / Stability)</div>"]:::monitor
	O["<div style='color:#fff;font-weight:600'>14. Explainability & Reporting<br/>(Feature contribution, WoE tables)</div>"]:::monitor
	P((Deploy & Monitor))

	A --> B --> C --> D --> E --> F --> G --> H --> I --> J --> K --> L --> M --> N --> O --> P

	%% Click bindings to open module detail files (relative paths)
	click B "./module_01_data_ingestion.mmd" "Open: Data Ingestion Module" _self
	click C "./module_02_variable_classification.mmd" "Open: Variable Classification" _self
	click D "./module_03_missing_values.mmd" "Open: Missing Data Handling" _self
	click E "./module_04_outliers.mmd" "Open: Outlier Treatment" _self
	click F "./module_05_coarse_binning.mmd" "Open: Coarse Binning" _self
	click G "./module_06_fine_binning.mmd" "Open: Fine Binning" _self
	click H "./module_07_woe_iv_selection.mmd" "Open: WoE & IV Selection" _self
	click I "./module_08_encoding_transform.mmd" "Open: Encoding & Transformations" _self
	click J "./module_09_model_training.mmd" "Open: Model Training" _self
	click K "./module_10_score_scaling.mmd" "Open: Score Scaling" _self
	click L "./module_11_performance_validation.mmd" "Open: Performance Validation" _self
	click M "./module_12_fairness_bias.mmd" "Open: Fairness & Bias" _self
	click N "./module_13_monitoring.mmd" "Open: Monitoring & Drift" _self
	click O "./module_14_explainability_reporting.mmd" "Open: Explainability & Reporting" _self

	%% Legend (implicit via classes)
	subgraph LEGEND [Legend]
		direction LR
		L1[Data]:::data --> L2[Process]:::proc --> L3[Risk/Model]:::risk --> L4[Decision / Assessment]:::decision --> L5[Monitoring]:::monitor
	end
	style LEGEND fill:#111827,stroke:#6b7280,stroke-dasharray: 3 3,color:#ffffff
