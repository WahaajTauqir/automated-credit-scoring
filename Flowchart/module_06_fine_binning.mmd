%% Module 06: Fine Binning
%% Goal: Achieve monotonic (or near) relationship of WoE vs Bad Rate, optimize predictive stability.
%% Techniques: Recursive splitting, monotonicity enforcement, PSI pre-check.
%%{init: {"theme": "dark", "flowchart": {"defaultRenderer": "elk", "htmlLabels": false}} }%%
flowchart TB
    classDef step fill:#1e293b,stroke:#60a5fa,color:#ffffff;
    classDef decision fill:#3b2f13,stroke:#fbbf24,color:#ffffff;

    A((From Coarse Binning)):::step
    S0["Load Coarse Bins & Candidate Variables (IV >=0.02)"]:::step
    S1["Within each coarse bin attempt further splits ensuring >=3% rows per fine bin"]:::step
    S2["Compute bad rate & WoE per candidate split"]:::step
    D1{"Monotonic WoE Violated?"}:::decision
    S3["Merge adjacent violating bins (minimize IV loss)" ]:::step
    S4["Stop when further split increases IV < 1% OR min bin size violated"]:::step
    S5["Check Stability: PSI < 0.1 vs validation sample (if available)"]:::step
    D2{"PSI >=0.1?"}:::decision
    S6["If unstable: revert latest split or coarsen"]:::step
    S7["Finalize Fine Bin Map + WoE Table"]:::step
    E((To WoE & IV Selection))

    A --> S0 --> S1 --> S2 --> D1
    D1 -->|Yes| S3 --> S2
    D1 -->|No| S4 --> S5 --> D2
    D2 -->|Yes| S6 --> S5
    D2 -->|No| S7 --> E

    subgraph OUTPUTS [Artifacts]
        O1[Fine Bin Edges]
        O2[WoE Table]
        O3[Monotonicity Report]
    end
    style OUTPUTS fill:#111827,stroke:#6b7280,stroke-dasharray: 3 3,color:#ffffff

    click E "./module_07_woe_iv_selection.mmd" "Next: WoE & IV Selection" _self
