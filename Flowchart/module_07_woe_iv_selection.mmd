%% Module 07: WoE & IV Computation + Variable Selection
%% Goal: Produce well-behaved predictor set with limited multicollinearity and strong predictive info.
%%{init: {"theme": "dark", "flowchart": {"defaultRenderer": "elk", "htmlLabels": false}} }%%
flowchart TB
    classDef step fill:#1e293b,stroke:#60a5fa,color:#ffffff;
    classDef decision fill:#3b2f13,stroke:#fbbf24,color:#ffffff;

    A((From Fine Binning)):::step
    S0["Compute WoE per Fine Bin: WoE = ln( (Good_i/Total_Good) / (Bad_i/Total_Bad) )"]:::step
    S1["Recompute Variable IV = Σ (Dist_Good_i - Dist_Bad_i) * WoE_i"]:::step
    S2["Filter Variables: IV >=0.02"]:::step
    S3["Correlation matrix (Spearman) on WoE-transformed; flag pairs with |rho|>0.8"]:::step
    D1{"Highly Correlated Pair?"}:::decision
    S4["Keep higher IV / Business relevance / Lower missing"]:::step
    S5["Variance Inflation Factor (VIF) iterative removal threshold VIF>5"]:::step
    S6["Univariate KS & AUC sanity check"]:::step
    S7["Assemble Final Candidate Set"]:::step
    E((To Encoding & Transform))

    A --> S0 --> S1 --> S2 --> S3 --> D1
    D1 -->|Yes| S4 --> S3
    D1 -->|No| S5 --> S6 --> S7 --> E

    subgraph OUTPUTS [Artifacts]
        O1[WoE Tables]
        O2[IV Ranking]
        O3[Correlation Report]
        O4[Selected Variable List]
    end
    style OUTPUTS fill:#111827,stroke:#6b7280,stroke-dasharray: 3 3,color:#ffffff

    click E "./module_08_encoding_transform.mmd" "Next: Encoding & Transform" _self
